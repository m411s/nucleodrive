<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NucleoDrive.App.ViewModels"
             x:Class="NucleoDrive.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="760" Margin="0,0,8,0">
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="Settings" />
        <TextBlock Classes="muted" Text="Account, the Proton Drive CLI, appearance and startup" />
      </StackPanel>

      <!-- account -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="iconTile" Margin="0,0,14,0" VerticalAlignment="Top">
            <Path Classes="icon tint" Data="{StaticResource Icon.User}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Classes="h2" Text="Proton account" />
            <TextBlock Text="{Binding AccountStatus}" TextWrapping="Wrap" />
            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="Signing in opens your browser. Your password never passes through NucleoDrive; the session is kept in your system keyring. NucleoDrive is a third-party app, not made or supported by Proton." />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top">
            <Button Classes="accent" Command="{Binding SignInCommand}" IsVisible="{Binding !IsSignedIn}">Sign in</Button>
            <Button Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}">Sign out</Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- CLI -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="iconTile" Margin="0,0,14,0" VerticalAlignment="Top">
            <Path Classes="icon tint" Data="{StaticResource Icon.Terminal}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Classes="h2" Text="Proton Drive CLI" />
            <TextBlock Text="{Binding CliStatus}" TextWrapping="Wrap" />
            <SelectableTextBlock Classes="muted small" Text="{Binding CliPath}" IsVisible="{Binding HasCli}" />
            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="Proton's official build, downloaded from proton.me and checked against the SHA-512 checksum Proton publishes." />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding CliBusy}" Margin="0,6,0,0" />
          </StackPanel>
          <Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top" Command="{Binding InstallCliCommand}"
                  Content="{Binding InstallLabel}" />
        </Grid>
      </Border>

      <!-- what the CLI can't do -->
      <Expander Classes="limits" HorizontalAlignment="Stretch">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Classes="icon small tint" Data="{StaticResource Icon.Info}" />
            <TextBlock Text="What the Proton Drive CLI can't do" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="8" Margin="4,2,4,4">
              <TextBlock TextWrapping="Wrap" Classes="small">
                <Run FontWeight="SemiBold" Text="Changes made elsewhere aren't instant." /> <Run Text="The CLI can't report what changed on Drive, so NucleoDrive checks every hour (up to every 4 hours while nothing changes). Sync now checks straight away; changes on this computer upload within seconds." />
              </TextBlock>
              <TextBlock TextWrapping="Wrap" Classes="small">
                <Run FontWeight="SemiBold" Text="Checking Drive takes a while." /> <Run Text="Each CLI run takes about 1.5 s and lists one folder, so hundreds of folders take a minute or more." />
              </TextBlock>
              <TextBlock TextWrapping="Wrap" Classes="small">
                <Run FontWeight="SemiBold" Text="No online-only files." /> <Run Text="Synced folders are fully downloaded. Folders you don't sync stay browsable on the Files page." />
              </TextBlock>
              <TextBlock TextWrapping="Wrap" Classes="small">
                <Run FontWeight="SemiBold" Text="Proton Docs and Sheets can't be downloaded." /> <Run Text="They stay online-only; open them on the web." />
              </TextBlock>
              <TextBlock TextWrapping="Wrap" Classes="small">
                <Run FontWeight="SemiBold" Text="Only My files." /> <Run Text="Shared with me, Photos and Devices aren't synced." />
              </TextBlock>
              <TextBlock TextWrapping="Wrap" Classes="small">
                <Run FontWeight="SemiBold" Text="No progress within a single file." /> <Run Text="Progress is shown per file." />
              </TextBlock>
          </StackPanel>
      </Expander>

      <!-- appearance -->
      <Border Classes="card" IsVisible="{Binding HasAppearance}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="iconTile" Margin="0,0,14,0" VerticalAlignment="Center">
            <Path Classes="icon tint" Data="{StaticResource Icon.Sun}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="h2" Text="Appearance" />
            <TextBlock Classes="muted small" Text="Automatic follows your system's light or dark setting" TextWrapping="Wrap" />
          </StackPanel>
          <ListBox Grid.Column="2" x:Name="ThemeSwitch" Classes="segmented" Margin="12,0,0,0" VerticalAlignment="Center"
                   SelectedIndex="{Binding ThemeIndex}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem ToolTip.Tip="Follow the system setting">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon small" Data="{StaticResource Icon.Monitor}" />
                <TextBlock Text="Automatic" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon small" Data="{StaticResource Icon.Sun}" />
                <TextBlock Text="Light" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon small" Data="{StaticResource Icon.Moon}" />
                <TextBlock Text="Dark" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </Grid>
      </Border>

      <!-- startup -->
      <Border Classes="card" Padding="6">
        <StackPanel>
          <Border Classes="row">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding TrayAtLogin}" OnContent="" OffContent="" MinWidth="0" />
              <Path Classes="icon tint" Margin="0,0,12,0" Data="{StaticResource Icon.Power}" />
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Open at login" />
                <TextBlock Classes="muted small" Text="Starts NucleoDrive in the tray when you log in" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Classes="row">
            <DockPanel>
              <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ServiceEnabled}" IsEnabled="{Binding ServiceInstalled}"
                            OnContent="" OffContent="" MinWidth="0" />
              <Path Classes="icon tint" Margin="0,0,12,0" Data="{StaticResource Icon.Cloud}" />
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Sync in the background" />
                <TextBlock Classes="muted small" TextWrapping="Wrap"
                           Text="The background service keeps syncing, with or without the window or tray icon" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Border>

      <WrapPanel>
        <Button Classes="ghost" Command="{Binding RunSetupCommand}" Margin="0,0,6,6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon small" Data="{StaticResource Icon.Sliders}" />
            <TextBlock Text="Run setup again" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding AboutCommand}" Margin="0,0,6,6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon small" Data="{StaticResource Icon.Info}" />
            <TextBlock Text="About nucleodrive" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding LoadCommand}" Margin="0,0,6,6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon small" Data="{StaticResource Icon.Refresh}" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
