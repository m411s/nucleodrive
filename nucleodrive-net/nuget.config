<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org, whatever other feeds your user or machine NuGet config adds. With central package
     management, NuGet otherwise fails the restore (NU1507, warning as error) as soon as a second
     package source is configured anywhere. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
