<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pdrive.App.ViewModels"
        xmlns:pages="using:Pdrive.App.Views.Pages"
        x:Class="Pdrive.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Proton Drive (unofficial)"
        Background="{DynamicResource Pd.Window}"
        Width="940" Height="640" MinWidth="640" MinHeight="420">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:BrowserViewModel"><pages:FilesPage /></DataTemplate>
    <DataTemplate DataType="vm:SyncViewModel"><pages:SyncPage /></DataTemplate>
    <DataTemplate DataType="vm:BackupViewModel"><pages:BackupPage /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><pages:SettingsPage /></DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="208,*">
    <!-- sidebar -->
    <Border Grid.Column="0" Background="{DynamicResource Pd.Sidebar}">
      <DockPanel Margin="12,16,12,12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,0,20">
          <Image x:Name="Logo" Width="26" Height="26" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Proton Drive" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="unofficial" Classes="muted small" />
          </StackPanel>
        </StackPanel>

        <!-- status pill -->
        <Border DockPanel.Dock="Bottom" Classes="status">
          <Grid ColumnDefinitions="Auto,*">
            <Ellipse Classes="dot" Margin="2,5,10,0" VerticalAlignment="Top"
                     Classes.ok="{Binding StatusOk}" Classes.busy="{Binding StatusBusy}" Classes.warn="{Binding StatusWarn}"
                     Classes.error="{Binding StatusError}" Classes.off="{Binding StatusOff}" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StatusDetail}" Classes="muted small" TextWrapping="Wrap" MaxLines="3"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>

        <ListBox x:Name="Nav" Classes="nav" SelectedIndex="{Binding PageIndex}">
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="{StaticResource Icon.Folder}" />
              <TextBlock Text="Files" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="{StaticResource Icon.Sync}" />
              <TextBlock Text="Sync" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="{StaticResource Icon.Archive}" />
              <TextBlock Text="Backup" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem IsVisible="{Binding Settings, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon" Data="{StaticResource Icon.Sliders}" />
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- page -->
    <TransitioningContentControl Grid.Column="1" Margin="28,22,20,20" Content="{Binding CurrentPage}">
      <TransitioningContentControl.PageTransition>
        <CrossFade Duration="0:0:0.15" />
      </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>
  </Grid>
</Window>
