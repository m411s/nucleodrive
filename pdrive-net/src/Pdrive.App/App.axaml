<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pdrive.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0E7C93" />
        <ColorPaletteResources x:Key="Dark" Accent="#1595AB" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Styles/Theme.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- kept for older markup -->
      <StreamGeometry x:Key="FolderIcon">M2,5 C2,4 3,3 4,3 L9,3 L11,5 L20,5 C21,5 22,6 22,7 L22,19 C22,20 21,21 20,21 L4,21 C3,21 2,20 2,19 Z</StreamGeometry>
      <StreamGeometry x:Key="FileIcon">M6,2 L14,2 L20,8 L20,20 C20,21 19,22 18,22 L6,22 C5,22 4,21 4,20 L4,4 C4,3 5,2 6,2 Z M13,3 L13,9 L19,9</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>
</Application>
