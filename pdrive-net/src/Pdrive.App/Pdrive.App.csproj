<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>pdrive</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Pdrive.Cli/Pdrive.Cli.csproj" />
    <ProjectReference Include="../Pdrive.Ipc/Pdrive.Ipc.csproj" />
    <ProjectReference Include="../Pdrive.Sync/Pdrive.Sync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pdrive.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- App icon; source artwork is assets/pdrive.svg -->
    <AvaloniaResource Include="../../assets/icons/pdrive-256.png" Link="Assets/pdrive.png" />
    <AvaloniaResource Include="../../../LICENSE" Link="Assets/LICENSE.txt" />
  </ItemGroup>
</Project>
