#!/usr/bin/env python3
import sys, json, os
a = sys.argv[1:]
log = os.environ.get("FAKE_LOG")
def rec(*x):
    if log:
        with open(log, "a") as f: f.write(json.dumps(x) + "\n")
if a[:2] == ["filesystem", "list"]:
    if a[2] == "/my-files":
        print(json.dumps([{"name": "b.txt", "type": "file", "size": 2048},
                          {"name": "Documents", "type": "folder"}]))
    elif a[2] == "/nope":
        sys.stderr.write("not logged in: run auth login\n"); sys.exit(1)
    elif a[2] == "/offline":
        sys.stderr.write("network error: connection refused\n"); sys.exit(1)
    else:
        print(json.dumps({"items": []}))
elif a[:2] == ["filesystem", "upload"]:
    if os.environ.get("FAKE_FAIL") and any(os.environ["FAKE_FAIL"] in x for x in a[2:]):
        sys.stderr.write("boom\n"); sys.exit(1)
    rec("upload", *a[2:]); print("uploaded", a[2:])
elif a[:2] == ["filesystem", "mkdir"]:
    rec("mkdir", a[2]); print("ok")
elif a[:2] == ["filesystem", "download"]:
    print("downloaded", a[2:])
elif a[:2] == ["auth", "login"]:
    print("ok")
else:
    sys.stderr.write("unknown\n"); sys.exit(2)
